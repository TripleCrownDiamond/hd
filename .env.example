# Public application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (image delivery + upload script)
# CLOUD_NAME is public and hard-coded in src/lib/cloudinary.ts; API key/secret
# are ONLY used server-side by scripts/upload-image.mjs — never exposed to the client.
CLOUDINARY_CLOUD_NAME=pq4soawt
CLOUDINARY_API_KEY=159766499532764
CLOUDINARY_API_SECRET=

# ─────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────
# Local dev via `supabase start`:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key printed by `supabase start`>
#   SUPABASE_SECRET_KEY=<service_role key printed by `supabase start`>  # PRIVILEGED, server-only
#
# Hosted project:
#   NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from Project Settings → API>
#   SUPABASE_SECRET_KEY=<service_role key — Project Settings → API>
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Kept for backwards compat with older Supabase docs (same value as SUPABASE_SECRET_KEY)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

